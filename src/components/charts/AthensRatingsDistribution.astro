---
const ratings = [
  { rating: '1.0', count: 43 }, { rating: '1.1', count: 0 }, { rating: '1.2', count: 0 }, { rating: '1.3', count: 0 }, { rating: '1.4', count: 0 },
  { rating: '1.5', count: 2 }, { rating: '1.6', count: 0 }, { rating: '1.7', count: 0 }, { rating: '1.8', count: 0 }, { rating: '1.9', count: 0 },
  { rating: '2.0', count: 23 }, { rating: '2.1', count: 0 }, { rating: '2.2', count: 0 }, { rating: '2.3', count: 2 }, { rating: '2.4', count: 0 },
  { rating: '2.5', count: 8 }, { rating: '2.6', count: 1 }, { rating: '2.7', count: 3 }, { rating: '2.8', count: 5 }, { rating: '2.9', count: 0 },
  { rating: '3.0', count: 73 }, { rating: '3.1', count: 1 }, { rating: '3.2', count: 3 }, { rating: '3.3', count: 13 }, { rating: '3.4', count: 3 },
  { rating: '3.5', count: 50 }, { rating: '3.6', count: 40 }, { rating: '3.7', count: 25 }, { rating: '3.8', count: 39 }, { rating: '3.9', count: 13 },
  { rating: '4.0', count: 287 }, { rating: '4.1', count: 79 }, { rating: '4.2', count: 161 }, { rating: '4.3', count: 205 }, { rating: '4.4', count: 271 },
  { rating: '4.5', count: 746 }, { rating: '4.6', count: 1059 }, { rating: '4.7', count: 1602 }, { rating: '4.8', count: 2693 }, { rating: '4.9', count: 2697 },
  { rating: '5.0', count: 3107 },
];

const totalRated = 13241;
const totalListings = 15584;
const maxCount = Math.max(...ratings.map((d) => d.count));
const maxShare = Math.max(...ratings.map((d) => (d.count / totalRated) * 100));
const width = 820;
const height = 480;
const plot = { left: 70, right: 70, top: 128, bottom: 346 };
const plotWidth = width - plot.left - plot.right;
const plotHeight = plot.bottom - plot.top;
const barGap = 3;
const barWidth = (plotWidth - barGap * (ratings.length - 1)) / ratings.length;
const ticks = [0, 1, 2, 3, 4].map((i) => Math.round((maxCount * i) / 4));

const yForCount = (count: number) => plot.bottom - (count / maxCount) * plotHeight;
const xForIndex = (index: number) => plot.left + index * (barWidth + barGap);
const tickRatings = new Set(['1.0', '2.0', '3.0', '4.0', '4.5', '4.8', '5.0']);
const superhostX = xForIndex(38) + barWidth / 2;
const guestFavoriteX = xForIndex(39) + barWidth / 2;
const peakX = xForIndex(40) + barWidth / 2;
const peakY = yForCount(3107);
---

<figure class="rating-chart" data-athens-rating-chart data-total-rated={totalRated} data-max-count={maxCount} data-max-share={maxShare.toFixed(4)} aria-label="Athens Airbnb ratings distribution">
  <div class="chart-head">
    <div>
      <h3>Athens Airbnb ratings distribution</h3>
      <p>{totalRated.toLocaleString()} rated listings out of {totalListings.toLocaleString()}; median 4.87, mean 4.76.</p>
    </div>
    <div class="chart-controls" aria-label="Chart mode">
      <button type="button" data-mode="count" aria-pressed="true">Count</button>
      <button type="button" data-mode="share" aria-pressed="false">Share</button>
    </div>
  </div>

  <div class="chart-canvas">
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Interactive histogram of Athens Airbnb review scores, binned by 0.1 rating increments">
      <g class="annotation-key">
        <path class="marker superhost" d={`M ${plot.left} 42 L ${plot.left + 10} 25 L ${plot.left + 20} 42 Z`} />
        <text class="superhost" x={plot.left + 32} y="39">4.8 Superhost minimum</text>
        <path class="marker favorite" d={`M ${plot.left + 280} 42 L ${plot.left + 290} 25 L ${plot.left + 300} 42 Z`} />
        <text class="favorite" x={plot.left + 312} y="39">4.9 Guest Favorite</text>
        <rect class="peak-sample" x={plot.left + 520} y="27" width="20" height="15" rx="2" />
        <text class="peak-note" x={plot.left + 552} y="39">5.0 peak: 3,107 listings</text>
      </g>

      {ticks.map((tick) => {
        const y = yForCount(tick);
        return (
          <g class="y-tick" data-y-tick data-count={tick} data-share={((tick / totalRated) * 100).toFixed(1)}>
            <line x1={plot.left} y1={y} x2={plot.left + plotWidth} y2={y} />
            <text x={plot.left - 12} y={y + 4} text-anchor="end">{tick.toLocaleString()}</text>
          </g>
        );
      })}

      <line class="axis" x1={plot.left} y1={plot.bottom} x2={plot.left + plotWidth} y2={plot.bottom} />
      <text class="axis-label" x={plot.left + plotWidth / 2} y={height - 24} text-anchor="middle">Rating</text>
      <text class="axis-label" data-y-axis-label x="20" y={plot.top + plotHeight / 2} transform={`rotate(-90 20 ${plot.top + plotHeight / 2})`} text-anchor="middle">Number of listings</text>

      {ratings.map((d, index) => {
        const x = xForIndex(index);
        const y = yForCount(d.count);
        const barHeight = plot.bottom - y;
        const share = (d.count / totalRated) * 100;
        return (
          <g>
            <rect
              class="bar"
              data-bar
              data-rating={d.rating}
              data-count={d.count}
              data-share={share.toFixed(3)}
              x={x}
              y={y}
              width={barWidth}
              height={barHeight}
              rx="2"
              tabindex="0"
            />
            {tickRatings.has(d.rating) && (
              <text class="x-tick" x={x + barWidth / 2} y={plot.bottom + 24} text-anchor="middle">{d.rating}</text>
            )}
          </g>
        );
      })}

      <line class="threshold superhost" x1={superhostX} y1={plot.top} x2={superhostX} y2={plot.bottom} />
      <line class="threshold favorite" x1={guestFavoriteX} y1={plot.top} x2={guestFavoriteX} y2={plot.bottom} />
      <path class="chart-marker superhost" d={`M ${superhostX - 6} ${plot.top - 12} L ${superhostX + 6} ${plot.top - 12} L ${superhostX} ${plot.top - 1} Z`} />
      <path class="chart-marker favorite" d={`M ${guestFavoriteX - 6} ${plot.top - 12} L ${guestFavoriteX + 6} ${plot.top - 12} L ${guestFavoriteX} ${plot.top - 1} Z`} />
      <text class="peak-label" x={peakX} y={peakY - 16} text-anchor="middle">3,107</text>
    </svg>
    <div class="tooltip" data-tooltip hidden></div>
  </div>

  <figcaption>Source: Inside Airbnb Athens listings export. Empty-rating listings are excluded from the histogram.</figcaption>
</figure>

<style>
  .rating-chart {
    --bg: #faf8f5;
    --text: #1a1a1a;
    --muted: #777777;
    --grid: #e8e3dc;
    --copper: #c17f59;
    --superhost: #b87333;
    --favorite: #2c5282;
    margin: 2rem 0;
    padding: 1.25rem;
    background: var(--bg);
    border-radius: 6px;
    color: var(--text);
    overflow: visible;
  }

  .chart-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 0.65rem;
  }

  h3 {
    margin: 0 0 0.25rem;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
  }

  p,
  figcaption {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .chart-controls {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  button {
    border: 0;
    border-radius: 5px;
    padding: 0.45rem 0.8rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: #4d4d4d;
    background: #e8e3dc;
    cursor: pointer;
  }

  button[aria-pressed='true'] {
    color: #fff;
    background: var(--copper);
    font-weight: 600;
  }

  .chart-canvas {
    position: relative;
    overflow-x: auto;
    overflow-y: visible;
    scrollbar-width: thin;
  }

  svg {
    display: block;
    width: 100%;
    min-width: 680px;
    height: auto;
    overflow: visible;
  }

  .annotation-key text {
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 600;
  }

  .annotation-key .superhost {
    fill: var(--superhost);
  }

  .annotation-key .favorite {
    fill: var(--favorite);
  }

  .peak-note {
    fill: var(--text);
  }

  .marker.superhost,
  .chart-marker.superhost {
    fill: var(--superhost);
  }

  .marker.favorite,
  .chart-marker.favorite {
    fill: var(--favorite);
  }

  .threshold {
    stroke-dasharray: 5 6;
    stroke-width: 1.6;
  }

  .threshold.superhost {
    stroke: var(--superhost);
  }

  .threshold.favorite {
    stroke: var(--favorite);
  }

  .peak-sample {
    fill: var(--copper);
    opacity: 0.82;
  }

  .y-tick line {
    stroke: var(--grid);
    stroke-width: 1;
  }

  .y-tick text,
  .x-tick {
    font-family: var(--font-mono);
    font-size: 12.5px;
    fill: var(--muted);
  }

  .peak-label {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    fill: var(--text);
  }

  .axis {
    stroke: var(--muted);
    stroke-width: 1.1;
  }

  .axis-label {
    font-family: var(--font-heading);
    font-size: 14px;
    fill: var(--text);
  }

  .bar {
    fill: var(--copper);
    opacity: 0.82;
    outline: none;
    transition: opacity 0.15s ease, y 0.2s ease, height 0.2s ease;
  }

  .bar:hover,
  .bar:focus {
    opacity: 1;
  }

  .tooltip {
    position: fixed;
    z-index: 20;
    pointer-events: none;
    transform: translate(12px, 12px);
    padding: 0.5rem 0.6rem;
    border-radius: 4px;
    background: rgba(250, 248, 245, 0.96);
    box-shadow: 0 8px 24px rgba(47, 40, 32, 0.14);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.86rem;
    line-height: 1.4;
  }

  .tooltip strong {
    font-family: var(--font-mono);
  }

  figcaption {
    margin-top: 0.5rem;
  }

  @media (max-width: 640px) {
    .rating-chart {
      margin-left: -0.5rem;
      margin-right: -0.5rem;
      padding: 1rem 0.75rem;
    }

    .chart-head {
      flex-direction: column;
    }
  }
</style>

<script is:inline>
  document.querySelectorAll('[data-athens-rating-chart]').forEach((chart) => {
    if (chart.dataset.ready === 'true') return;
    chart.dataset.ready = 'true';

    const totalRated = Number(chart.dataset.totalRated);
    const maxCount = Number(chart.dataset.maxCount);
    const maxShare = Number(chart.dataset.maxShare);
    const plotBottom = 346;
    const plotHeight = 218;
    const bars = Array.from(chart.querySelectorAll('[data-bar]'));
    const yTicks = Array.from(chart.querySelectorAll('[data-y-tick]'));
    const tooltip = chart.querySelector('[data-tooltip]');
    const buttons = Array.from(chart.querySelectorAll('[data-mode]'));
    const yAxisLabel = chart.querySelector('[data-y-axis-label]');
    const peakLabel = chart.querySelector('.peak-label');
    const peakBar = bars.find((bar) => bar.dataset.rating === '5.0');

    function formatShare(value) {
      return `${Number(value).toFixed(1)}%`;
    }

    function formatCount(value) {
      return Number(value).toLocaleString();
    }

    function update(mode) {
      const max = mode === 'share' ? maxShare : maxCount;
      bars.forEach((bar) => {
        const value = mode === 'share' ? Number(bar.dataset.share) : Number(bar.dataset.count);
        const height = (value / max) * plotHeight;
        bar.setAttribute('y', String(plotBottom - height));
        bar.setAttribute('height', String(height));
      });

      yTicks.forEach((tick, index) => {
        const value = (max * index) / (yTicks.length - 1);
        const y = plotBottom - (value / max) * plotHeight;
        tick.querySelector('line').setAttribute('y1', String(y));
        tick.querySelector('line').setAttribute('y2', String(y));
        const text = tick.querySelector('text');
        text.setAttribute('y', String(y + 4));
        text.textContent = mode === 'share' ? formatShare(value) : formatCount(Math.round(value));
      });

      if (peakLabel && peakBar) {
        const y = Number(peakBar.getAttribute('y'));
        peakLabel.setAttribute('y', String(y - 16));
        peakLabel.textContent = mode === 'share' ? formatShare(peakBar.dataset.share) : '3,107';
      }

      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.mode === mode));
      });

      if (yAxisLabel) {
        yAxisLabel.textContent = mode === 'share' ? 'Share of rated listings' : 'Number of listings';
      }

      chart.dataset.mode = mode;
    }

    function positionTooltip(event, target) {
      if ('clientX' in event && event.clientX) {
        tooltip.style.left = `${event.clientX}px`;
        tooltip.style.top = `${event.clientY}px`;
        return;
      }
      const box = target.getBoundingClientRect();
      tooltip.style.left = `${box.left + box.width / 2}px`;
      tooltip.style.top = `${box.top}px`;
    }

    function showTooltip(event, bar) {
      const count = Number(bar.dataset.count);
      const share = (count / totalRated) * 100;
      tooltip.innerHTML = `<strong>${bar.dataset.rating}</strong><br>${count.toLocaleString()} listings<br>${share.toFixed(1)}% of rated listings`;
      tooltip.hidden = false;
      positionTooltip(event, bar);
    }

    buttons.forEach((button) => button.addEventListener('click', () => update(button.dataset.mode)));
    bars.forEach((bar) => {
      bar.addEventListener('pointermove', (event) => showTooltip(event, bar));
      bar.addEventListener('focus', (event) => showTooltip(event, bar));
      bar.addEventListener('pointerleave', () => { tooltip.hidden = true; });
      bar.addEventListener('blur', () => { tooltip.hidden = true; });
    });
  });
</script>
