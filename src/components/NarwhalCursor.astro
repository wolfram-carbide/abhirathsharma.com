<div id="narwhal-cursor" aria-hidden="true">
  <img src="/images/posts/narwhal-cursor.svg" alt="" width="64" height="64" draggable="false" />
</div>

<style>
  /*
   * Hide native cursor on desktop only.
   * The @media (hover: hover) check in JS handles this at runtime,
   * but we also scope the CSS rule so it never fires on touch-only devices.
   */
  @media (hover: hover) and (pointer: fine) {
    :global(*) {
      cursor: none !important;
    }
  }

  #narwhal-cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 99999;
    /* Start invisible until first mousemove */
    opacity: 0;
    transition: opacity 0.25s ease;
    /* GPU-accelerated positioning */
    will-change: transform;
    /* Position element so horn tip (SVG coord 4,12) sits at mouse point */
    transform: translate(-4px, -12px);
  }

  #narwhal-cursor img {
    display: block;
    width: 64px;
    height: 64px;
    /* Rotate around the horn tip */
    transform-origin: 4px 12px;
    user-select: none;
  }

  /* --- Loading state: gentle undulating bob --- */
  #narwhal-cursor.is-loading img {
    animation: narwhal-bob 1.4s ease-in-out infinite;
  }

  /* --- Click state: energetic swim burst --- */
  #narwhal-cursor.is-clicking img {
    animation: narwhal-swim 0.6s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }

  @keyframes narwhal-bob {
    0%, 100% {
      transform: rotate(0deg) translateY(0px) scale(1);
    }
    50% {
      transform: rotate(-9deg) translateY(-5px) scale(1.04);
    }
  }

  @keyframes narwhal-swim {
    0%   { transform: rotate(0deg) translateY(0px); }
    12%  { transform: rotate(-20deg) translateY(-5px); }
    28%  { transform: rotate(12deg) translateY(3px); }
    46%  { transform: rotate(-14deg) translateY(-3px); }
    64%  { transform: rotate(8deg) translateY(2px); }
    80%  { transform: rotate(-5deg) translateY(-1px); }
    100% { transform: rotate(0deg) translateY(0px); }
  }
</style>

<script>
  // Only activate the custom cursor on devices that have a fine pointer (mouse/trackpad)
  // and support hover — i.e. real desktops. Touch-only devices are unaffected.
  const isPointerDevice =
    window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (isPointerDevice) {
    const cursor = document.getElementById('narwhal-cursor') as HTMLElement;
    const img = cursor.querySelector('img') as HTMLImageElement;

    // ── Positioning ────────────────────────────────────────────────
    // Target position (raw mouse coords)
    let targetX = -200;
    let targetY = -200;
    // Current interpolated position
    let currentX = -200;
    let currentY = -200;
    let hasEntered = false;

    const LERP = 0.14; // lower = smoother/slower follow
    const HOTSPOT_X = 4;
    const HOTSPOT_Y = 12;

    function tick() {
      currentX += (targetX - currentX) * LERP;
      currentY += (targetY - currentY) * LERP;
      cursor.style.transform = `translate(${currentX - HOTSPOT_X}px, ${currentY - HOTSPOT_Y}px)`;
      requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);

    document.addEventListener('mousemove', (e) => {
      targetX = e.clientX;
      targetY = e.clientY;

      if (!hasEntered) {
        // Snap to position on first entry so it doesn't slide in from (0,0)
        currentX = targetX;
        currentY = targetY;
        hasEntered = true;
        cursor.style.opacity = '1';
      }
    });

    document.addEventListener('mouseleave', () => {
      cursor.style.opacity = '0';
    });

    document.addEventListener('mouseenter', () => {
      if (hasEntered) cursor.style.opacity = '1';
    });

    // ── Loading state ───────────────────────────────────────────────
    if (document.readyState !== 'complete') {
      cursor.classList.add('is-loading');
      window.addEventListener('load', () => {
        cursor.classList.remove('is-loading');
      }, { once: true });
    }

    // ── Click / swim animation ──────────────────────────────────────
    document.addEventListener('mousedown', () => {
      // Remove then re-add to restart animation if already running
      cursor.classList.remove('is-clicking');
      // Tiny delay lets the class removal flush before re-adding
      requestAnimationFrame(() => {
        cursor.classList.add('is-clicking');
      });
    });

    img.addEventListener('animationend', (e) => {
      if (e.animationName === 'narwhal-swim') {
        cursor.classList.remove('is-clicking');
      }
    });
  }
</script>
