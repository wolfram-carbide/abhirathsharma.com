---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Personal website' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/writing" class={currentPath.startsWith('/writing') ? 'active' : ''}>Writing</a>
        <a href="/visual-essays" class={currentPath.startsWith('/visual-essays') ? 'active' : ''}>Visual essays</a>
        <a href="/projects" class={currentPath.startsWith('/projects') ? 'active' : ''}>Side projects</a>
        <a href="/about" class={currentPath.startsWith('/about') ? 'active' : ''}>About me</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p class="date">© {new Date().getFullYear()}</p>
    </footer>
  </body>
</html>

<style>
  header {
    margin-bottom: 3rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  nav a {
    color: var(--color-text);
    font-weight: 500;
  }

  nav a.active {
    color: var(--color-accent);
  }

  nav a:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  main {
    min-height: 60vh;
  }

  footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }
</style>
