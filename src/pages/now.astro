---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Now">
  <article>
    <h1>What I'm Doing Now</h1>
    <p class="date">Updated December 2025</p>

    <section>
      <p>
        Exploring my interests in economics, biology, product management and AI. Some of these will be published here.
      </p>
    </section>

    <section>
      <h2>Books I liked recently</h2>
      <ul>
        <li>Narrative Economics</li>
        <li>Empire of Pain</li>
        <li>What Went Wrong with Capitalism</li>
        <li>Steve Jobs biography</li>
        <li>The Intelligence Trap</li>
      </ul>
    </section>

    <footer>
      <p class="muted">
        This is a <a href="https://nownownow.com/about" target="_blank" rel="noopener noreferrer">now page</a>.
        It's a snapshot of what I'm focused on at this point in my life.
      </p>
    </footer>
  </article>
</BaseLayout>

<style>
  article {
    max-width: 680px;
  }

  h1 {
    margin-bottom: 0.5rem;
  }

  article > .date {
    display: block;
    margin-bottom: 3rem;
  }

  section {
    margin-bottom: 2.5rem;
  }

  section h2 {
    margin-bottom: 1rem;
  }

  ul {
    margin-left: 1.5rem;
  }

  li {
    margin-bottom: 0.5rem;
  }

  footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .muted {
    color: var(--color-muted);
  }
</style>
