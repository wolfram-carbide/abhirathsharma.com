---
import BaseLayout from '../layouts/BaseLayout.astro';

// You can add your photos here or fetch them from a directory
const photos = [
  {
    src: '/images/photo1.jpg',
    alt: 'Photo description',
    caption: 'Optional caption',
  },
  // Add more photos as needed
];
---

<BaseLayout title="Photos">
  <h1>Photos</h1>
  <p class="subtitle">Coming Soon</p>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--color-muted);
    margin-bottom: 3rem;
  }

  .photo-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }

  figure {
    margin: 0;
  }

  img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    border-radius: 6px;
    display: block;
  }

  figcaption {
    margin-top: 0.5rem;
    text-align: center;
  }

  .muted {
    color: var(--color-muted);
  }
</style>
