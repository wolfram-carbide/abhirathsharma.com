---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'Mendmate',
    description: 'A recovery companion that helps you track your progress after an injury, and helps you have a better conversation with your physio.',
    link: 'https://mendmate.replit.app/',
  },
  {
    title: 'Strum Dudio',
    description: 'A virtual drum machine that I built for myself as I struggle with yet another hobby.',
    link: 'https://strum-dudio.lovable.app',
  },
  {
    title: 'Cherry Prompt',
    description: 'Get inspired, cherry pick prompts and paste it in your image gen model',
    link: 'https://cherryprompt.abhirathsharma.com/',
  },
  {
    title: 'True IMDb ratings',
    description: 'Find out how your log curve of perceived IMDb quality looks like. Bonus: a 2x2 IMDb personality matrix.',
    link: 'https://true-imdb-scale.lovable.app',
  },
  {
    title: 'Roast and Toast',
    description: 'A party game where you periodically roast all members of your group.',
    link: 'https://roastandtoastparty.lovable.app',
  },
  {
    title: 'Bespoke canines',
    description: 'A dystopian idea portraying conflicts of consumerism, pet care and animal welfare',
    link: 'https://designer-pup-generator.replit.app/',
  },
];

const knowledgeArtefacts = [
  {
    title: 'Multiple approaches to AI',
    description: 'What Yann LeCun, Fei-Fei Li and Demis Hassabis are building next',
    link: 'https://claude.ai/public/artifacts/08e5c174-3bc4-4abb-b678-3fe8281d9147',
  },
];
---

<BaseLayout title="Side projects">
  <h1>Side projects</h1>
  <p class="subtitle">Tools and applications I've built.</p>

  <section class="section">
    <h2 class="section-heading">Projects</h2>
    {projects.length === 0 ? (
      <p class="muted">No projects yet.</p>
    ) : (
      <div class="projects-grid">
        {projects.map((project) => (
          <article class="project-card">
            <h3>
              {project.link ? (
                <a href={project.link} target="_blank" rel="noopener noreferrer">
                  {project.title} ↗
                </a>
              ) : (
                project.title
              )}
            </h3>
            <p>{project.description}</p>
            {project.tags && project.tags.length > 0 && (
              <div class="tags">
                {project.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    )}
  </section>

  <section class="section">
    <h2 class="section-heading">Knowledge artefacts</h2>
    {knowledgeArtefacts.length === 0 ? (
      <p class="muted">No artefacts yet.</p>
    ) : (
      <div class="projects-grid">
        {knowledgeArtefacts.map((artefact) => (
          <article class="project-card artefact-card">
            <h3>
              {artefact.link ? (
                <a href={artefact.link} target="_blank" rel="noopener noreferrer">
                  {artefact.title} ↗
                </a>
              ) : (
                artefact.title
              )}
            </h3>
            <p>{artefact.description}</p>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--color-muted);
    margin-bottom: 3rem;
  }

  .section {
    margin-bottom: 4rem;
  }

  .section-heading {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .project-card {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition: border-color 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--color-accent);
  }

  .project-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .project-card h3 a {
    color: var(--color-text);
  }

  .project-card h3 a:hover {
    color: var(--color-accent);
  }

  .project-card p {
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .artefact-card {
    border-style: dashed;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    background: var(--color-border);
    border-radius: 3px;
  }

  .muted {
    color: var(--color-muted);
  }
</style>
