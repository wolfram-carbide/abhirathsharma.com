---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: '$f-k-readability',
    description: "A skill to improve Claude's readability score",
    link: 'https://readability-lab.wolframcarbide.chatgpt.site/',
  },
  {
    title: 'Mendmate',
    description: 'A recovery companion that helps you track your progress after an injury, and helps you have a better conversation with your physio.',
    link: 'https://mendmate.replit.app/',
  },
  {
    title: 'Strum Dudio',
    description: 'A virtual drum machine that I built for myself as I struggle with yet another hobby.',
    link: 'https://strum-dudio.lovable.app',
  },
  {
    title: 'Cherry Prompt',
    description: 'Get inspired, cherry pick prompts and paste it in your image gen model',
    link: 'https://cherryprompt.abhirathsharma.com/',
  },
  {
    title: 'True IMDb ratings',
    description: 'Find out how your log curve of perceived IMDb quality looks like. Bonus: a 2x2 IMDb personality matrix.',
    link: 'https://true-imdb-scale.lovable.app',
  },
  {
    title: 'Roast and Toast',
    description: 'A party game where you periodically roast all members of your group.',
    link: 'https://roastandtoastparty.lovable.app',
  },
  {
    title: 'Bespoke canines',
    description: 'A dystopian idea portraying conflicts of consumerism, pet care and animal welfare',
    link: 'https://bespoke-canines.replit.app',
  },
];
---

<BaseLayout title="Side projects">
  <h1>Side projects</h1>
  <p class="subtitle">Tools and applications I've built.</p>

  {projects.length === 0 ? (
    <p class="muted">No projects yet.</p>
  ) : (
    <div class="projects-grid">
      {projects.map((project) => (
        <article class="project-card">
          <h2>
            {project.link ? (
              <a href={project.link} target="_blank" rel="noopener noreferrer">
                {project.title} ↗
              </a>
            ) : (
              project.title
            )}
          </h2>
          <p>{project.description}</p>
          {project.tags && project.tags.length > 0 && (
            <div class="tags">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  )}
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--color-muted);
    margin-bottom: 3rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .project-card {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition: border-color 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--color-accent);
  }

  .project-card h2 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .project-card h2 a {
    color: var(--color-text);
  }

  .project-card h2 a:hover {
    color: var(--color-accent);
  }

  .project-card p {
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    background: var(--color-border);
    border-radius: 3px;
  }

  .muted {
    color: var(--color-muted);
  }
</style>
