---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <header>
      <h1>{post.data.title}</h1>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
      <time class="date">{post.data.date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short'
      })}</time>
    </header>

    <div class="content">
      <Content />
    </div>

    <div class="engagement">
      <button class="heart-button" data-slug={post.slug}>
        <svg class="heart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
        <span class="heart-count"></span>
      </button>
    </div>

    <footer>
      <a href="/writing">← Back to all posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  article {
    max-width: 680px;
  }

  header {
    margin-bottom: 3rem;
  }

  h1 {
    margin-bottom: 1.5rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .tag {
    padding: 0.2rem 0.6rem;
    background: var(--color-border);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    font-weight: 400;
  }

  time {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    opacity: 0.7;
    letter-spacing: 0.02em;
  }

  .content {
    margin-bottom: 4rem;
  }

  .content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .content :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .content :global(ul),
  .content :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .content :global(li) {
    margin-bottom: 0.5rem;
  }

  .content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: var(--color-muted);
  }

  .engagement {
    position: relative;
    margin-bottom: 3rem;
  }

  .heart-button {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem;
    transition: transform 0.2s ease;
    position: absolute;
    bottom: 0;
    left: 0;
  }

  .heart-button:hover {
    transform: scale(1.1);
  }

  .heart-button:active {
    transform: scale(0.95);
  }

  .heart-icon {
    width: 20px;
    height: 20px;
    color: var(--color-accent);
    transition: all 0.3s ease;
  }

  .heart-button:hover .heart-icon {
    color: #A66947;
  }

  .heart-button.liked .heart-icon {
    fill: var(--color-accent);
    animation: heartbeat 0.3s ease;
  }

  .heart-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    25% { transform: scale(1.2); }
    50% { transform: scale(0.95); }
  }

  footer {
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const heartButton = document.querySelector('.heart-button') as HTMLButtonElement;
    const heartCount = document.querySelector('.heart-count') as HTMLElement;

    if (!heartButton) return;

    const slug = heartButton.dataset.slug;
    const storageKey = `liked_${slug}`;

    // Load current like count and user's like status
    async function loadLikes() {
      try {
        const response = await fetch(`/api/likes/${slug}`);
        const data = await response.json();

        if (data.count > 0) {
          heartCount.textContent = data.count.toString();
        }

        // Check if user has already liked
        const hasLiked = localStorage.getItem(storageKey) === 'true';
        if (hasLiked) {
          heartButton.classList.add('liked');
        }
      } catch (error) {
        console.error('Failed to load likes:', error);
      }
    }

    // Handle like button click
    heartButton.addEventListener('click', async () => {
      const hasLiked = heartButton.classList.contains('liked');

      try {
        const response = await fetch(`/api/likes/${slug}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: hasLiked ? 'unlike' : 'like' })
        });

        const data = await response.json();

        if (hasLiked) {
          heartButton.classList.remove('liked');
          localStorage.removeItem(storageKey);
        } else {
          heartButton.classList.add('liked');
          localStorage.setItem(storageKey, 'true');
        }

        heartCount.textContent = data.count > 0 ? data.count.toString() : '';
      } catch (error) {
        console.error('Failed to update like:', error);
      }
    });

    loadLikes();
  });
</script>
